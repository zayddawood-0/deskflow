# DeskFlow backend — copy to .env
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Postgres from docker compose
DATABASE_URL=postgresql+psycopg2://deskflow:deskflow@localhost:5432/deskflow
CORS_ORIGINS=http://localhost:3000
SLA_AT_RISK_THRESHOLD=0.75
REOPEN_WINDOW_DAYS=7
INTERNAL_TASK_TOKEN=local-internal-token
LOG_LEVEL=DEBUG
